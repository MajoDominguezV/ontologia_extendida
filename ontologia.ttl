ex:construccion_tipo_medicina__construccion_y_urbanismo__objeto__mundo_material a skos:Concept ;
    skos:prefLabel "Construcción-Tipo-Medicina"@es ;
    skos:definition "Tipos de construcciones de carácter médico."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:construccion_y_urbanismo__objeto__mundo_material ;
    ex:pregunta "¿Se trata de un tipo de construcción médica?"@es ;
    ex:respuesta "Sí, es un sanatorio."@es ;
    ex:ejemplo "La reconstrucción del sanatorio."@es .

