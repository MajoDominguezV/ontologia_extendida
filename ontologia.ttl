# ---- Mundo Material — Objeto — Gastronomía — Animal ----

ex:mamifero__animal__gastronomia_e_ingesta__objeto__mundo_material a skos:Concept ;
    skos:prefLabel "Mamífero (Gastronomía)"@es ;
    skos:definition "Alimentos de origen mamífero."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:animal__gastronomia_e_ingesta__objeto__mundo_material ;
    ex:pregunta "¿Se trata de un mamífero preparado o cocinado para ser ingerido?"@es ;
    ex:respuesta "Sí, se puede oler/se puede comer."@es ;
    ex:ejemplo "El sabor del churrasco."@es ;

ex:ave__animal__gastronomia_e_ingesta__objeto__mundo_material a skos:Concept ;
    skos:prefLabel "Ave (Gastronomía)"@es ;
