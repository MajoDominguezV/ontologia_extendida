    skos:broader ex:general__partes_del_cuerpo__mundo_animado ;
    ex:pregunta "Pertenece al mundo animado. ¿Es una parte del cuerpo de un animal?"@es ;
    ex:respuesta "Sí, es una garra."@es ;
    ex:ejemplo "La rotura de la pata."@es .

ex:vegetal__general__partes_del_cuerpo__mundo_animado a skos:Concept ;
    skos:prefLabel "Vegetal"@es ;
    skos:definition "Partes de vegetales en general."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:general__partes_del_cuerpo__mundo_animado ;
    ex:pregunta "Pertenece al mundo animado. ¿Es una parte de un vegetal?"@es ;
    ex:respuesta "Sí, es el tallo de una flor."@es ;
    ex:ejemplo "El tronco de los castaños."@es .

# ---- Mundo Animado — Partes del cuerpo — Interna ----

ex:humano__interna__partes_del_cuerpo__mundo_animado a skos:Concept ;
    skos:prefLabel "Humano (Partes del cuerpo interna)"@es ;
    skos:definition "Partes internas del cuerpo humano (músculos y huesos)."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:interna__partes_del_cuerpo__mundo_animado ;
    ex:pregunta "Pertenece al mundo animado. ¿Es una parte interna del cuerpo de un ser humano?"@es ;
    ex:respuesta "Sí, es el radio."@es ;
    ex:ejemplo "La rotura del peroné."@es .

ex:animal__interna__partes_del_cuerpo__mundo_animado a skos:Concept ;
    skos:prefLabel "Animal (Partes del cuerpo interna)"@es ;
    skos:definition "Partes internas del cuerpo de animales."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:interna__partes_del_cuerpo__mundo_animado ;
    ex:pregunta "Pertenece al mundo animado. ¿Es una parte interna del cuerpo de un animal?"@es ;
    ex:respuesta "Sí, es la quilla."@es ;
    ex:ejemplo "La desviación de la coracoides."@es .

