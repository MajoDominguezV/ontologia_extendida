ex:economicas__actividades_y_acciones__situaciones_dinamicas a skos:Concept ;
    skos:prefLabel "Económicas"@es ;
    skos:definition "Describe procesos ligados a actividades o acciones de tipo económico."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:actividades_y_acciones__situaciones_dinamicas ;
    ex:pregunta "Se trata de una situación dinámica. ¿Se trata de una actividad o acción de tipo económico?"@es ;
    ex:respuesta "Sí, se trata de una actividad, la de la re-industrialización."@es ;
    ex:ejemplo "El aumento de la industrialización."@es ;
