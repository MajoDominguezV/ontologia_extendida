    skos:prefLabel "General (Animales)"@es ;
    skos:definition "Describe representantes del mundo animal en general. Animal es el nodo común a toda la categoría."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:animales__mundo_animado ;
    ex:pregunta "Pertenece al mundo animado. ¿Es un animal?"@es ;
    ex:respuesta "Sí, es un animal."@es ;
    ex:ejemplo "El olor de los cerdos."@es ;
