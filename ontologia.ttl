# ============================================================
# Ontología ESMAS-ES+ 2.0
# Sistema Taxonómico Integral para la Clasificación
# Semántica del Conocimiento
# ============================================================

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://grupoportlex.github.io/ontologia/skos/> .

# ============================================================
# Propiedades de anotación personalizadas
# ============================================================

ex:pregunta a rdf:Property ;
    rdfs:label "Pregunta de clasificación"@es ;
    rdfs:comment "Pregunta guía para identificar si un término pertenece a esta categoría."@es ;
    rdfs:subPropertyOf skos:note ;
    rdfs:domain skos:Concept ;
    rdfs:range rdfs:Literal .

ex:respuesta a rdf:Property ;
    rdfs:label "Respuesta de clasificación"@es ;
    rdfs:comment "Respuesta ejemplo que confirma la pertenencia de un término a esta categoría."@es ;
    rdfs:subPropertyOf skos:note ;
    rdfs:domain skos:Concept ;
    rdfs:range rdfs:Literal .

ex:ejemplo a rdf:Property ;
    rdfs:label "Ejemplo de uso"@es ;
    rdfs:comment "Sintagma nominal de ejemplo que ilustra un caso de uso típico de esta categoría."@es ;
    rdfs:subPropertyOf skos:note ;
    rdfs:domain skos:Concept ;
    rdfs:range rdfs:Literal .

# ============================================================
# ESQUEMA GENERAL
# ============================================================

ex:mundos_scheme a skos:ConceptScheme ;
    skos:prefLabel "Sistema Taxonómico Integral para la Clasificación Semántica del Conocimiento"@es ;
    dct:creator "ESMAS-ES+" ;
    dct:description "Una arquitectura conceptual avanzada que organiza y categoriza el conocimiento humano a través de siete mundos interconectados, facilitando la comprensión sistemática de la realidad desde lo tangible hasta lo abstracto."@es .

# ============================================================
# NIVEL 1 — Los siete mundos
# ============================================================

ex:mundo_animado a skos:Concept ;
    skos:prefLabel "Mundo Animado"@es ;
    skos:definition "Diferencia seres vivos frente a otros representantes de otros mundos."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:narrower ex:ser_humano__mundo_animado, ex:criaturas__mundo_animado, ex:animales__mundo_animado, ex:vegetales__mundo_animado, ex:partes_del_cuerpo__mundo_animado ;
    skos:note "contraposicion: per negationem"@es,
    "relacion_especifica: Es un ser vivo, parte de un ser vivo o grupo. Puede respirar."@es .

ex:mundo_material a skos:Concept ;
    skos:prefLabel "Mundo Material"@es ;
    skos:definition "Diferencia representantes del mundo material frente a otros representantes de otros mundos."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:narrower ex:objeto__mundo_material, ex:sustancia__mundo_material ;
    skos:note "contraposicion: per negationem"@es,
    "relacion_especifica: Es tangible/sólido/líquido/gaseoso, es visible/observable/perceptible."@es .

ex:mundo_intelectual a skos:Concept ;
    skos:prefLabel "Mundo Intelectual"@es ;
    skos:definition "Describe representantes del mundo intelectual en cuanto a su contenido."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:narrower ex:contenido__mundo_intelectual, ex:comunicacion__mundo_intelectual, ex:tematica__mundo_intelectual, ex:sistemas_de_orden__mundo_intelectual ;
    skos:note "contraposicion: per negationem"@es,
    "relacion_especifica: Es abstracto, no es tangible/sólido/líquido/gaseoso, no es visible/observable/perceptible."@es .

ex:situaciones_dinamicas a skos:Concept ;
    skos:prefLabel "Situaciones dinámicas"@es ;
    skos:definition "Diferencia situaciones dinámicas frente a otros representantes de otros mundos."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:narrower ex:humanas_volitivas_o_intencionales__situaciones_dinamicas, ex:motrices__situaciones_dinamicas, ex:naturales__situaciones_dinamicas, ex:acontecimientos__situaciones_dinamicas, ex:actividades_y_acciones__situaciones_dinamicas ;
    skos:note "contraposicion: per negationem"@es,
    "relacion_especifica: Son actividades, acciones y procesos ligados al dinamismo."@es .

ex:situaciones_estaticas a skos:Concept ;
    skos:prefLabel "Situaciones estáticas"@es ;
    skos:definition "Representan situaciones estáticas: atributos, condiciones, características físicas y emocionales así como evaluaciones."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:narrower ex:atributos_o_cualidades__situaciones_estaticas, ex:estados_emocionales__situaciones_estaticas, ex:estados_fisicos__situaciones_estaticas ;
    skos:note "contraposicion: per negationem"@es,
    "relacion_especifica: Son atributos, condiciones, evaluaciones, características físicas y emocionales."@es .

ex:lugar a skos:Concept ;
    skos:prefLabel "Lugar"@es ;
    skos:definition "Diferencia lugares frente a otros representantes de otros mundos."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:narrower ex:general__lugar, ex:paisaje__lugar, ex:tipos_de_construcciones_y_partes__lugar, ex:poblacion__lugar, ex:territorio__lugar, ex:puntos_cardinales__lugar, ex:espacios_virtuales__lugar, ex:locomocion__lugar ;
    skos:note "contraposicion: per negationem"@es,
    "relacion_especifica: Son lugares, edificios o espacios en general."@es .

ex:unidades a skos:Concept ;
    skos:prefLabel "Unidades"@es ;
    skos:definition "Diferencia unidades frente a otros representantes de otros mundos."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:narrower ex:general__unidades, ex:tiempo__unidades, ex:cantidad__unidades, ex:monetaria__unidades, ex:medida_espacial__unidades, ex:informacion_digital__unidades, ex:potencia__unidades ;
    skos:note "contraposicion: per negationem"@es,
    "relacion_especifica: Unidades de medición y ordenación cronológica."@es .

# ============================================================
# NIVEL 2
# ============================================================
# ---- Mundo Animado ----

ex:ser_humano__mundo_animado a skos:Concept ;
    skos:prefLabel "Ser Humano"@es ;
    skos:definition "Diferencia ser humano frente a otros representantes del mundo animado."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:mundo_animado ;
    skos:narrower ex:condicion_y_relacion__ser_humano__mundo_animado, ex:actividad__ser_humano__mundo_animado, ex:pensamiento_y_creencia__ser_humano__mundo_animado, ex:organizaciones_y_grupos__ser_humano__mundo_animado ;
    skos:note "contraposicion: per negationem"@es,
    "relacion_especifica: Es un ser vivo, parte de un ser vivo o grupo. Puede respirar."@es .

ex:criaturas__mundo_animado a skos:Concept ;
    skos:prefLabel "Criaturas"@es ;
    skos:definition "Diferencia criaturas de ficción frente a otros representantes del mundo animado."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:mundo_animado ;
    skos:narrower ex:general__criaturas__mundo_animado, ex:nombre_propio__criaturas__mundo_animado ;
    skos:note "contraposicion: per negationem"@es,
    "relacion_especifica: Es un ser de ficción. Puede respirar."@es .

ex:animales__mundo_animado a skos:Concept ;
    skos:prefLabel "Animales"@es ;
    skos:definition "Diferencia representantes del mundo animal frente a otros representantes del mundo animado."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:mundo_animado ;
    skos:narrower ex:general__animales__mundo_animado,
        ex:mamifero__animales__mundo_animado,
        ex:ave__animales__mundo_animado,
        ex:pez__animales__mundo_animado,
        ex:reptil__animales__mundo_animado,
        ex:insecto__animales__mundo_animado,
        ex:albatros__animales__mundo_animado,
        ex:anaconda__animales__mundo_animado,
        ex:caniche__animales__mundo_animado,
        ex:castor__animales__mundo_animado,
        ex:jaguar__animales__mundo_animado,
        ex:koala__animales__mundo_animado,
        ex:panda__animales__mundo_animado,
        ex:puma__animales__mundo_animado,
        ex:tigre__animales__mundo_animado ;
    skos:note "contraposicion: per negationem"@es,
    "relacion_especifica: Es un ser vivo. Puede desplazarse."@es .

ex:vegetales__mundo_animado a skos:Concept ;
    skos:prefLabel "Vegetales"@es ;
    skos:definition "Diferencia representantes del mundo vegetal frente a otros representantes del mundo animado."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:mundo_animado ;
    skos:narrower ex:planta__vegetales__mundo_animado, ex:arbol__vegetales__mundo_animado, ex:flor__vegetales__mundo_animado, ex:fruta__vegetales__mundo_animado, ex:hortaliza__vegetales__mundo_animado, ex:especias_y_condimentos__vegetales__mundo_animado,
        ex:floral__vegetales__mundo_animado;
    skos:note "contraposicion: per negationem"@es,
    "relacion_especifica: Es un ser vivo. Puede realizar fotosíntesis."@es .

ex:partes_del_cuerpo__mundo_animado a skos:Concept ;
    skos:prefLabel "Partes del cuerpo"@es ;
    skos:definition "Diferencia partes de seres vivos frente a otros representantes del mundo animado."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:mundo_animado ;
    skos:narrower ex:general__partes_del_cuerpo__mundo_animado, ex:externa__partes_del_cuerpo__mundo_animado, ex:interna__partes_del_cuerpo__mundo_animado, ex:recubrimiento__partes_del_cuerpo__mundo_animado, ex:organos__partes_del_cuerpo__mundo_animado ;
    skos:note "contraposicion: per negationem"@es,
    "relacion_especifica: Es una parte de un ser vivo."@es .

# ---- Mundo Material ----

ex:objeto__mundo_material a skos:Concept ;
    skos:prefLabel "Objeto (Mundo Material)"@es ;
    skos:definition "Diferencia representantes del mundo material (objetos) frente a otros representantes del mundo material."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:mundo_material ;
    skos:narrower ex:categorias_de_productos__objeto__mundo_material, ex:gastronomia_e_ingesta__objeto__mundo_material, ex:construccion_y_urbanismo__objeto__mundo_material, ex:vestimenta__objeto__mundo_material, ex:locomocion__objeto__mundo_material, ex:comunicacion__objeto__mundo_material ;
    skos:note "contraposicion: per negationem"@es,
    "relacion_especifica: Es tangible/sólido/líquido, es visible/observable/perceptible."@es .

ex:sustancia__mundo_material a skos:Concept ;
    skos:prefLabel "Sustancia"@es ;
    skos:definition "Diferencia sustancias frente a otros representantes del mundo material."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:mundo_material ;
    skos:narrower ex:general__sustancia__mundo_material, ex:carburante__sustancia__mundo_material, ex:medicamento__sustancia__mundo_material, ex:excremento__sustancia__mundo_material, ex:secrecion__sustancia__mundo_material, ex:gas__sustancia__mundo_material, ex:liquido_no_consumible__sustancia__mundo_material, ex:gastronomia_e_ingesta__sustancia__mundo_material ;
    skos:note "contraposicion: per negationem"@es,
    "relacion_especifica: Es tangible/sólido/líquido/gaseoso, es visible/observable/perceptible."@es .

ex:medicamento__sustancia__mundo_material a skos:Concept ;
    skos:prefLabel "Medicamento (sustancia)"@es ;
    skos:definition "Describe sustancias de tipo medicamento. Sustancia es el nodo común a la categoría."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:sustancia__mundo_material ;
    ex:pregunta "¿Se trata de un medicamento en forma de sustancia?"@es ;
    ex:respuesta "Sí, es un jarabe."@es ;
    ex:ejemplo "El olor del antiséptico."@es .

# ---- Mundo Intelectual ----

ex:contenido__mundo_intelectual a skos:Concept ;
    skos:prefLabel "Contenido (Mundo Intelectual)"@es ;
    skos:definition "Describe objetos como unidades de contenido. Unidades de contenido es el nodo común a toda la categoría. Es abstracto, no es tangible, es perceptible."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:mundo_intelectual ;
    skos:narrower ex:general__contenido__mundo_intelectual, ex:significado__contenido__mundo_intelectual, ex:documento__contenido__mundo_intelectual, ex:texto__contenido__mundo_intelectual .

ex:comunicacion__mundo_intelectual a skos:Concept ;
    skos:prefLabel "Comunicación (Mundo Intelectual)"@es ;
    skos:definition "Describe objetos como formas de comunicación. Comunicación es el nodo común a toda la categoría. Es abstracto, no es tangible."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:mundo_intelectual ;
    skos:narrower ex:lengua__comunicacion__mundo_intelectual, ex:enunciado_declaracion_y_expresion__comunicacion__mundo_intelectual, ex:acuerdo__comunicacion__mundo_intelectual, ex:oferta__comunicacion__mundo_intelectual .

ex:tematica__mundo_intelectual a skos:Concept ;
    skos:prefLabel "Temática"@es ;
    skos:definition "Describe el contenido de un objeto según su temática. Temática es el nodo común a toda la categoría. Es abstracto, no es tangible."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:mundo_intelectual ;
    skos:narrower ex:creencia_religiosa__tematica__mundo_intelectual, ex:area_de_conocimiento__tematica__mundo_intelectual, ex:ideologia__tematica__mundo_intelectual .

ex:sistemas_de_orden__mundo_intelectual a skos:Concept ;
    skos:prefLabel "Sistemas de orden"@es ;
    skos:definition "Describe representantes del mundo intelectual en cuanto a su estructura o sistema. Sistemas de orden es el nodo común a toda la categoría."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:mundo_intelectual ;
    skos:narrower ex:economico_impuestos_y_tasas__sistemas_de_orden__mundo_intelectual ;
    skos:note "contraposicion: Es abstracto, no es tangible."@es .

# ---- Situaciones Dinámicas ----

ex:humanas_volitivas_o_intencionales__situaciones_dinamicas a skos:Concept ;
    skos:prefLabel "Humanas volitivas o intencionales"@es ;
    skos:definition "Describe procesos que implican dinamismo con participación humana volitiva o intencional. Dinamismo es el nodo común a la categoría."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:situaciones_dinamicas ;
    skos:narrower ex:general__humanas_volitivas_o_intencionales__situaciones_dinamicas, ex:medico__humanas_volitivas_o_intencionales__situaciones_dinamicas, ex:violencia__humanas_volitivas_o_intencionales__situaciones_dinamicas, ex:formacion__humanas_volitivas_o_intencionales__situaciones_dinamicas, ex:tiempo_libre__humanas_volitivas_o_intencionales__situaciones_dinamicas, ex:trabajo__humanas_volitivas_o_intencionales__situaciones_dinamicas, ex:cognitivo_o_intelectual__humanas_volitivas_o_intencionales__situaciones_dinamicas .

ex:motrices__situaciones_dinamicas a skos:Concept ;
    skos:prefLabel "Motrices"@es ;
    skos:definition "Describe procesos que implican motricidad."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:situaciones_dinamicas ;
    ex:pregunta "Se trata de una situación dinámica. ¿Se trata de un proceso que implica cambio motriz?"@es ;
    ex:respuesta "Sí, se trata de un bofetón de una niña mayor a una niña pequeña."@es ;
    ex:ejemplo "El dolor del golpe/bofetón."@es ;
    skos:narrower ex:agresion__motrices__situaciones_dinamicas,
        ex:apaleamiento__motrices__situaciones_dinamicas,
        ex:bofetada__motrices__situaciones_dinamicas,
        ex:bofeton__motrices__situaciones_dinamicas,
        ex:cachete__motrices__situaciones_dinamicas,
        ex:colleja__motrices__situaciones_dinamicas,
        ex:cuchillada__motrices__situaciones_dinamicas,
        ex:cuchillazo__motrices__situaciones_dinamicas,
        ex:golpe__motrices__situaciones_dinamicas,
        ex:golpe_bajo__motrices__situaciones_dinamicas,
        ex:golpe_brusco__motrices__situaciones_dinamicas,ex:latigazo__motrices__situaciones_dinamicas,
        ex:lenazo__motrices__situaciones_dinamicas,
        ex:manotazo__motrices__situaciones_dinamicas,
        ex:navajazo__motrices__situaciones_dinamicas,
        ex:paliza__motrices__situaciones_dinamicas,
        ex:patada__motrices__situaciones_dinamicas,
        ex:pelea__motrices__situaciones_dinamicas,
        ex:pelea_a_punetazos__motrices__situaciones_dinamicas,
        ex:pelea_con_cuchillos__motrices__situaciones_dinamicas,ex:porrazo__motrices__situaciones_dinamicas,
        ex:puntapie__motrices__situaciones_dinamicas,
        ex:punalada__motrices__situaciones_dinamicas,
        ex:punetazo__motrices__situaciones_dinamicas,
        ex:sopapo__motrices__situaciones_dinamicas,
        ex:torta__motrices__situaciones_dinamicas,
        ex:tortazo__motrices__situaciones_dinamicas,
        ex:zurra__motrices__situaciones_dinamicas .

ex:naturales__situaciones_dinamicas a skos:Concept ;
    skos:prefLabel "Naturales"@es ;
    skos:definition "Describe procesos naturales."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:situaciones_dinamicas ;
    skos:narrower ex:general__naturales__situaciones_dinamicas, ex:biologico__naturales__situaciones_dinamicas, ex:quimico__naturales__situaciones_dinamicas, ex:combustion__naturales__situaciones_dinamicas, ex:meteorologico__naturales__situaciones_dinamicas, ex:patologico__naturales__situaciones_dinamicas, ex:floracion__naturales__situaciones_dinamicas .

ex:patologico__naturales__situaciones_dinamicas a skos:Concept ;
    skos:prefLabel "Patológico"@es ;
    skos:definition "Describe procesos naturales de carácter patológico como enfermedades y afecciones."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:naturales__situaciones_dinamicas ;
    skos:narrower ex:acne__patologico__naturales__situaciones_dinamicas,
        ex:adenocarcinoma__patologico__naturales__situaciones_dinamicas,
