ex:fruta__color__atributos_o_cualidades__situaciones_estaticas a skos:Concept ;
    skos:prefLabel "Fruta (Color)"@es ;
    skos:definition "Atributo de color derivado de una fruta."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:color__atributos_o_cualidades__situaciones_estaticas ;
    ex:pregunta "Se trata de una situación estática. ¿Se trata de un atributo ligado a un color de una fruta?"@es ;
    ex:respuesta "Sí, informa o es un atributo relativo al color de una fruta."@es ;
    ex:ejemplo "El amarillo limón de las cortinas."@es ;
    .

