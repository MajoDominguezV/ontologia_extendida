    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:animal__gastronomia_e_ingesta__objeto__mundo_material ;
    ex:pregunta "¿Se trata de un ave preparada o cocinada para ser ingerida?"@es ;
    ex:respuesta "Sí, se puede oler/se puede comer."@es ;
    ex:ejemplo "El sabor del pavo."@es .

