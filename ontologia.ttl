    skos:broader ex:lugar ;
    skos:narrower ex:general__poblacion__lugar, ex:urbanismo__poblacion__lugar, ex:ciudad__poblacion__lugar, ex:pais__poblacion__lugar, ex:continente__poblacion__lugar .

ex:territorio__lugar a skos:Concept ;
    skos:prefLabel "Territorio"@es ;
