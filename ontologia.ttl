    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:area_de_conocimiento__intelectual__atributos_o_cualidades__situaciones_estaticas ;
    ex:pregunta "Se trata de una situación estática. ¿Se trata de un atributo ligado a un área de conocimiento?"@es ;
    ex:respuesta "Sí, informa o es un atributo relativo a un área de conocimiento."@es ;
    ex:ejemplo "El análisis lingüístico del texto."@es .

