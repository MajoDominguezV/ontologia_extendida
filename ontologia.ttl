# ---- Lugar ----

ex:general__lugar a skos:Concept ;
    skos:prefLabel "General (Lugar)"@es ;
    skos:definition "Presenta lugares, edificios o espacios en general."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:lugar ;
    ex:pregunta "Se trata de un lugar. ¿Se trata de un espacio?"@es ;
    ex:respuesta "Sí, es la playa."@es ;
    ex:ejemplo "El caudal del Sil."@es .

ex:paisaje__lugar a skos:Concept ;
    skos:prefLabel "Paisaje"@es ;
    skos:definition "Presenta espacios atendiendo a características o atributos paisajísticos."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:lugar ;
    skos:narrower ex:general__paisaje__lugar, ex:nombre_propio__paisaje__lugar, ex:acuatico__paisaje__lugar .

ex:tipos_de_construcciones_y_partes__lugar a skos:Concept ;
