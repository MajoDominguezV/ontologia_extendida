ex:floracion__naturales__situaciones_dinamicas a skos:Concept ;
    skos:prefLabel "Floración"@es ;
    skos:definition "Describe procesos naturales de tipo floración."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:naturales__situaciones_dinamicas ;
    ex:pregunta "Se trata de una situación dinámica. ¿Se trata de un proceso natural de floración?"@es ;
    ex:respuesta "Sí, se trata de la floración."@es ;
    ex:ejemplo "El olor de la floración."@es ;

# ---- Situaciones Dinámicas — Acontecimientos ----

ex:general__acontecimientos__situaciones_dinamicas a skos:Concept ;
    skos:prefLabel "General (Acontecimientos)"@es ;
    skos:definition "Describe procesos resultativos, causativos o no puntuales como acontecimientos en general."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:acontecimientos__situaciones_dinamicas ;
    ex:pregunta "Se trata de una situación dinámica. ¿Se trata de un evento?"@es ;
    ex:respuesta "Sí, es un suceso."@es ;
    ex:ejemplo "El nerviosismo del acontecimiento."@es .

ex:origen__acontecimientos__situaciones_dinamicas a skos:Concept ;
    skos:prefLabel "Origen (Acontecimiento)"@es ;
    skos:definition "Describe procesos acontecimiento de tipo origen o causa."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:acontecimientos__situaciones_dinamicas ;
    ex:pregunta "Se trata de una situación dinámica. ¿Se trata de un evento como origen?"@es ;
    ex:respuesta "Sí, es la causa."@es ;
    ex:ejemplo "El motivo de la pelea."@es .

ex:resultado__acontecimientos__situaciones_dinamicas a skos:Concept ;
    skos:prefLabel "Resultado"@es ;
    skos:definition "Describe procesos acontecimiento de tipo resultativo."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:acontecimientos__situaciones_dinamicas ;
    ex:pregunta "Se trata de una situación dinámica. ¿Se trata de un evento resultativo?"@es ;
    ex:respuesta "Sí, surgen/se obtienen resultados."@es ;
    ex:ejemplo "El desenlace de la situación."@es ;

ex:contratiempo__acontecimientos__situaciones_dinamicas a skos:Concept ;
    skos:prefLabel "Contratiempo"@es ;
    skos:definition "Describe procesos acontecimiento de tipo contratiempo."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:acontecimientos__situaciones_dinamicas ;
    ex:pregunta "Se trata de una situación dinámica. ¿Se trata de un evento definido como contratiempo?"@es ;
    ex:respuesta "Sí, surge un contratiempo."@es ;
    ex:ejemplo "El retraso del viaje por el atasco."@es ;

ex:encuentro__acontecimientos__situaciones_dinamicas a skos:Concept ;
    skos:prefLabel "Encuentro"@es ;
    skos:definition "Describe procesos acontecimiento de tipo encuentro."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:acontecimientos__situaciones_dinamicas ;
    skos:narrower ex:reunion__encuentro__acontecimientos__situaciones_dinamicas, ex:ceremonia__encuentro__acontecimientos__situaciones_dinamicas .

ex:efectivo__acontecimientos__situaciones_dinamicas a skos:Concept ;
    skos:prefLabel "Efectivo"@es ;
    skos:definition "Describe procesos acontecimiento de tipo efectivo (que ocurren o tienen lugar)."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:acontecimientos__situaciones_dinamicas ;
    ex:pregunta "Se trata de una situación dinámica. ¿Se trata de un evento efectivo?"@es ;
    ex:respuesta "Sí, el nacimiento del bebé."@es ;
    ex:ejemplo "La muerte por accidente/caída."@es .

# ---- Situaciones Dinámicas — Actividades y acciones ----

ex:general__actividades_y_acciones__situaciones_dinamicas a skos:Concept ;
    skos:prefLabel "General (Actividades y acciones)"@es ;
    skos:definition "Describe procesos ligados a actividades o acciones en general."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:actividades_y_acciones__situaciones_dinamicas ;
    ex:pregunta "Se trata de una situación dinámica. ¿Se trata de una actividad o acción?"@es ;
    ex:respuesta "Sí, es la exportación."@es ;
    ex:ejemplo "La emigración a América."@es .

ex:cambio__actividades_y_acciones__situaciones_dinamicas a skos:Concept ;
    skos:prefLabel "Cambio"@es ;
    skos:definition "Describe procesos ligados a actividades o acciones que implican cambio."@es ;
    skos:inScheme ex:mundos_scheme ;
