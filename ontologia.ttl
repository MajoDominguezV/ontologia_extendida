ex:cognitivo_o_intelectual__humanas_volitivas_o_intencionales__situaciones_dinamicas a skos:Concept ;
    skos:prefLabel "Cognitivo o intelectual"@es ;
    skos:definition "Describe procesos dinámicos de tipo cognitivo o intelectual con participación humana volitiva o intencional."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:humanas_volitivas_o_intencionales__situaciones_dinamicas ;
    ex:pregunta "Se trata de una situación dinámica. ¿Se trata de un proceso cognitivo o intelectual?"@es ;
    ex:respuesta "Sí, se trata de una reflexión."@es ;
    ex:ejemplo "El razonamiento del filósofo."@es .

# ---- Situaciones Dinámicas — Naturales ----

ex:general__naturales__situaciones_dinamicas a skos:Concept ;
    skos:prefLabel "General (Naturales)"@es ;
    skos:definition "Describe procesos naturales en general."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:naturales__situaciones_dinamicas ;
    ex:pregunta "Se trata de una situación dinámica. ¿Se trata de un proceso natural?"@es ;
    ex:respuesta "Sí, de un terremoto."@es ;
    ex:ejemplo "La erosión de la naturaleza."@es .

ex:biologico__naturales__situaciones_dinamicas a skos:Concept ;
    skos:prefLabel "Biológico"@es ;
    skos:definition "Describe procesos naturales de tipo biológico."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:naturales__situaciones_dinamicas ;
    ex:pregunta "Se trata de una situación dinámica. ¿Se trata de un proceso natural biológico?"@es ;
    ex:respuesta "Sí, es un parto."@es ;
    ex:ejemplo "El dolor del parto."@es ;
    skos:narrower ex:alumbramiento__biologico__naturales__situaciones_dinamicas,
        ex:digestion__biologico__naturales__situaciones_dinamicas,
        ex:formacion_de_ampollas__biologico__naturales__situaciones_dinamicas,
        ex:nacimiento__biologico__naturales__situaciones_dinamicas,
        ex:ovulacion__biologico__naturales__situaciones_dinamicas,
        ex:parto__biologico__naturales__situaciones_dinamicas .

ex:quimico__naturales__situaciones_dinamicas a skos:Concept ;
    skos:prefLabel "Químico"@es ;
    skos:definition "Describe procesos naturales de tipo químico."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:naturales__situaciones_dinamicas ;
    ex:pregunta "Se trata de una situación dinámica. ¿Se trata de un proceso natural químico?"@es ;
    ex:respuesta "Sí, se trata de la combustión."@es ;
    ex:ejemplo "El dolor de la quemadura/digestión."@es .

ex:combustion__naturales__situaciones_dinamicas a skos:Concept ;
    skos:prefLabel "Combustión"@es ;
    skos:definition "Describe procesos naturales de tipo combustión."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:naturales__situaciones_dinamicas ;
    ex:pregunta "Se trata de una situación dinámica. ¿Se trata de un proceso natural de combustión?"@es ;
    ex:respuesta "Sí, se trata de un incendio."@es ;
    ex:ejemplo "La erupción del volcán."@es .

ex:meteorologico__naturales__situaciones_dinamicas a skos:Concept ;
    skos:prefLabel "Meteorológico"@es ;
    skos:definition "Describe procesos naturales de tipo meteorológico."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:naturales__situaciones_dinamicas ;
    ex:pregunta "Se trata de una situación dinámica. ¿Se trata de un proceso natural meteorológico?"@es ;
    ex:respuesta "Sí, se trata de la tormenta."@es ;
    ex:ejemplo "El ruido de la tormenta."@es ;.

