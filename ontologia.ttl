ex:mamifero__animales__mundo_animado a skos:Concept ;
    skos:prefLabel "Mamífero (Animal)"@es ;
    skos:definition "Describe representantes del mundo animal según su tipología. Mamífero es el nodo común a toda la categoría."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:animales__mundo_animado ;
    ex:pregunta "Pertenece al mundo animado. ¿Es un mamífero?"@es ;
    ex:respuesta "Sí, es un perro."@es ;
    ex:ejemplo "El olfato del perro."@es ;
    skos:narrower ex:panda__mamifero__animales__mundo_animado,
