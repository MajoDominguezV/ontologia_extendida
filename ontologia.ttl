ex:refeccion__gastronomia_e_ingesta__objeto__mundo_material a skos:Concept ;
    skos:prefLabel "Refección"@es ;
    skos:definition "Objetos o situaciones culinarias en las que se ingieren alimentos."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:gastronomia_e_ingesta__objeto__mundo_material ;
    ex:pregunta "¿Se trata de un objeto o situación culinaria en la que se ingieran alimentos?"@es ;
    ex:respuesta "Sí, se puede oler/se puede comer."@es ;
    ex:ejemplo "El olor del banquete."@es ;
    skos:narrower
ex:festin__refeccion__gastronomia_e_ingesta__objeto__mundo_material .

ex:harinas_y_postres__gastronomia_e_ingesta__objeto__mundo_material a skos:Concept ;
    skos:prefLabel "Harinas y postres"@es ;
    skos:definition "Objetos gastronómicos de tipo harinas y postres."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:gastronomia_e_ingesta__objeto__mundo_material ;
    ex:pregunta "¿Se trata de un objeto de tipo harinas o postres preparado para ser ingerido?"@es ;
    ex:respuesta "Sí, se puede oler/se puede comer."@es ;
    ex:ejemplo "El sabor del pastel."@es ;
    .

ex:animal__gastronomia_e_ingesta__objeto__mundo_material a skos:Concept ;
    skos:prefLabel "Animal (Gastronomía)"@es ;
    skos:definition "Objetos gastronómicos de origen animal."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:gastronomia_e_ingesta__objeto__mundo_material ;
    skos:narrower ex:mamifero__animal__gastronomia_e_ingesta__objeto__mundo_material, ex:ave__animal__gastronomia_e_ingesta__objeto__mundo_material, ex:acuatico_general__animal__gastronomia_e_ingesta__objeto__mundo_material, ex:acuatico_pescado__animal__gastronomia_e_ingesta__objeto__mundo_material, ex:acuatico_marisco__animal__gastronomia_e_ingesta__objeto__mundo_material .

ex:planta_y_condimento__gastronomia_e_ingesta__objeto__mundo_material a skos:Concept ;
    skos:prefLabel "Planta y condimento"@es ;
    skos:definition "Objetos gastronómicos de origen vegetal o condimento."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:gastronomia_e_ingesta__objeto__mundo_material ;
    ex:pregunta "¿Se trata de una planta o condimento preparado o cocinado para ser ingerido?"@es ;
    ex:respuesta "Sí, se puede oler/se puede comer."@es ;
    ex:ejemplo "El sabor de la pimienta."@es ;

