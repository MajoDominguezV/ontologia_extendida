# ---- Situaciones Dinámicas — Humanas volitivas o intencionales ----

ex:general__humanas_volitivas_o_intencionales__situaciones_dinamicas a skos:Concept ;
    skos:prefLabel "General (Humanas volitivas)"@es ;
    skos:definition "Describe procesos que implican dinamismo con participación humana volitiva o intencional en general. Dinamismo es el nodo común a la categoría."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:humanas_volitivas_o_intencionales__situaciones_dinamicas ;
    ex:pregunta "¿Se trata de una situación dinámica realizada por un humano?"@es ;
    ex:respuesta "Sí, se trata de un atropello."@es ;
    ex:ejemplo "El atraco al banco."@es .

