ex:nombre_propio__acuatico__paisaje__lugar a skos:Concept ;
    skos:prefLabel "Nombre propio (Acuático paisaje)"@es ;
    skos:definition "Espacios paisajísticos acuáticos identificados por su nombre propio."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:acuatico__paisaje__lugar ;
    ex:pregunta "Se trata de un lugar. ¿Se trata del nombre de un espacio acuático?"@es ;
    ex:respuesta "Sí, es el Mediterráneo."@es ;
    ex:ejemplo "La belleza del Nilo."@es .

# ---- Lugar — Tipos de construcciones — Parte ----

ex:general__parte__tipos_de_construcciones_y_partes__lugar a skos:Concept ;
    skos:prefLabel "General (Parte construcción)"@es ;
    skos:definition "Partes de construcciones en general."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:parte__tipos_de_construcciones_y_partes__lugar ;
    ex:pregunta "Se trata de un lugar. ¿Se trata de una parte de una construcción?"@es ;
    ex:respuesta "Sí, es la ventana."@es ;
    ex:ejemplo "El ancho de la ventana."@es .

ex:material__parte__tipos_de_construcciones_y_partes__lugar a skos:Concept ;
    skos:prefLabel "Material"@es ;
    skos:definition "Materiales de construcciones."@es ;
    skos:inScheme ex:mundos_scheme ;
    skos:broader ex:parte__tipos_de_construcciones_y_partes__lugar ;
    ex:pregunta "Se trata de un lugar. ¿Se trata de material de una construcción?"@es ;
    ex:respuesta "Sí, es una teja."@es ;
    ex:ejemplo "La baldosa del cuarto de baño."@es .

